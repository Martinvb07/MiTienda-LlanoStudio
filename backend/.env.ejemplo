# Copia este archivo a .env y completa los valores.
# NUNCA subas .env al repositorio.

NODE_ENV=development
PUERTO=4000

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://mitienda:clave@localhost:5432/mitienda?schema=public"

# ── Redis (colas BullMQ) ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Dominios / multi-tenant ──────────────────────────────────────────────────
# Dominio raíz bajo el que viven los subdominios de las tiendas.
# En desarrollo local usa "localhost" para poder probar mitienda.localhost:3000
DOMINIO_BASE="llanostudio.co"
# Subdominio reservado para el panel de administración.
SUBDOMINIO_PANEL="misitio"

# ── Seguridad ────────────────────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO="cambia-esto-en-produccion"
# Orígenes permitidos por CORS, separados por coma.
ORIGENES_PERMITIDOS="http://localhost:3000"

# Secreto compartido con el servidor de Next: le permite resolver el tenant en
# SSR indicando el Host original. Debe coincidir con MITIENDA_TOKEN_INTERNO del
# frontend. Déjalo vacío para deshabilitar la anulación.
TOKEN_INTERNO="cambia-esto-tambien-en-produccion"

# ── Bold (cobro de suscripciones) ─────────────────────────────────────────
# Panel de Bold > Integraciones > Llaves de integración. Usa primero las de
# pruebas y cámbialas por las de producción cuando todo funcione.
# El webhook se configura en Bold > Integraciones > Webhooks apuntando a
# https://misitio.llanostudio.co/api/bold/webhook
BOLD_LLAVE_IDENTIDAD=""
BOLD_LLAVE_SECRETA=""
# A dónde vuelve la persona después de pagar. Vacío = https://mitienda.<DOMINIO_BASE>
URL_PANEL=""

# ── Correos automáticos (opcional) ────────────────────────────────────────
# Con Gmail: SMTP_HOST=smtp.gmail.com, puerto 465 y una "contraseña de
# aplicación" (no tu contraseña normal). Vacío = no se envían correos.
SMTP_HOST=""
SMTP_PUERTO=465
SMTP_USUARIO=""
SMTP_CLAVE=""
CORREO_REMITENTE="Mi Sitio <hola@llanostudio.co>"

# ── Avisos push del panel (opcional) ──────────────────────────────────────
# Para que el celular de la dueña suene con cada pedido nuevo. Genera el par con
# `npx web-push generate-vapid-keys` (deploy/actualizar-vps.sh lo hace solo).
VAPID_PUBLICA=""
VAPID_PRIVADA=""

# ── Alertas de errores (opcional) ─────────────────────────────────────────
# Los errores 500 de la API y los que le pasan a alguien en el navegador
# llegan a este correo (vacío = ADMIN_CORREO). Como mucho uno igual cada 15 min.
ALERTAS_CORREO=""
# Webhook de Slack, Discord o Google Chat para recibirlos también en el chat.
ALERTAS_WEBHOOK=""

# ── Cloudflare R2 (opcional) ──────────────────────────────────────────────
# Sin R2 las fotos se guardan en backend/.medios. Las fotos se pasan a WebP al
# subirlas; las viejas se reoptimizan con `npm run medios:optimizar`.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mitienda-medios"
# Dominio público conectado al bucket (r2.dev o dominio propio de Cloudflare).
R2_URL_PUBLICA=""
# Bucket PRIVADO (otro, no el de las fotos) para la copia de los respaldos
# diarios de deploy/respaldar.sh. Vacío = los respaldos sólo quedan en el VPS.
R2_BUCKET_RESPALDOS=""

# Dominios propios: a dónde apuntan los clientes (CNAME para www, IP para el dominio raíz)
CNAME_DOMINIOS=tiendas.llanostudio.co
IP_SERVIDOR=
