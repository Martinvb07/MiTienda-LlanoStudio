{
  "name": "mitienda-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Mi Tienda (Llano Studio) — SaaS multi-tenant de e-commerce",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "dev:trabajadores": "tsx watch src/colas/trabajadores/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "start:trabajadores": "node dist/colas/trabajadores/index.js",
    "lint": "eslint .",
    "lint:corregir": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:observar": "vitest",
    "prisma:generar": "prisma generate",
    "prisma:migrar": "prisma migrate dev",
    "prisma:desplegar": "prisma migrate deploy",
    "prisma:estudio": "prisma studio",
    "admin:clave": "tsx scripts/clave-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bullmq": "^5.81.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
