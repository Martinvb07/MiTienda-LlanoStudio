// Esquema de datos de Mi Tienda — SaaS multi-tenant de e-commerce (Llano Studio)
//
// Estrategia de aislamiento: base de datos y esquema únicos, con separación por
// fila. Todo registro cuelga de un Tenant, ya sea de forma directa (tenantId) o
// a través de su Tienda (tiendaId). Todas las consultas de la API deben filtrar
// siempre por el tenant resuelto en el middleware `resolverTenant`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generado/prisma"
  moduleFormat = "esm"
}

// Prisma 7 ya no admite `url` aquí: la cadena de conexión para migraciones vive
// en prisma.config.ts, y el cliente en runtime la recibe vía driver adapter
// (ver src/config/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enumeraciones
// ─────────────────────────────────────────────────────────────────────────────

enum PlanTenant {
  GRATIS
  EMPRENDE
  NEGOCIO
  PRO
}

enum RolUsuario {
  PROPIETARIO
  ADMINISTRADOR
  EDITOR
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
  REEMBOLSADO
}

enum ProveedorPago {
  WOMPI
  PSE
  EPAYCO
  BOLD
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  ANULADO
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant y acceso
// ─────────────────────────────────────────────────────────────────────────────

/// Cuenta cliente de la plataforma. Es la raíz del aislamiento multi-tenant.
model Tenant {
  id          String     @id @default(cuid())
  nombre      String
  /// Etiqueta usada como <subdominio>.llanostudio.co. Única en toda la plataforma.
  subdominio  String     @unique
  plan        PlanTenant @default(GRATIS)
  activo      Boolean    @default(true)
  /// Hasta cuándo está pago el plan. null = no vence (Gratis, o puesto a mano
  /// por el admin). Pasados los días de gracia vuelve a Gratis.
  planVenceEn DateTime?

  /// Etiquetas internas del admin: "vip", "en riesgo", "beta"…
  etiquetas         String[]  @default([])
  /// De dónde llegó al registrarse (utm_source o referido).
  origen            String?
  /// Código que comparte para invitar a otras tiendas.
  codigoReferido    String?   @unique
  /// Tienda que la invitó.
  referidoPorId     String?
  /// Última vez que abrió las novedades: lo nuevo después de esto va con punto.
  novedadesVistasEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda           Tienda?
  usuarios         Usuario[]
  dominios         DominioPropio[]
  pagosSuscripcion PagoSuscripcion[]
  notas            NotaTienda[]
  historialPlanes  HistorialPlan[]
  tickets          TicketSoporte[]

  @@map("tenants")
}

/// Dominios propios apuntados a la plataforma ("tabla de dominios propios" que
/// consulta `resolverTenant` cuando el Host no cae bajo DOMINIO_BASE).
model DominioPropio {
  id       String @id @default(cuid())
  tenantId String
  /// Host completo en minúsculas y sin puerto, p. ej. "www.miropa.com".
  dominio  String @unique

  /// Pasa a true cuando se comprueba el registro DNS. `resolverTenant` sólo
  /// sirve tráfico de dominios verificados.
  verificado  Boolean @default(false)
  esPrincipal Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dominios_propios")
}

/// Usuario del panel de administración (dueño o colaborador de una tienda).
model Usuario {
  id       String @id @default(cuid())
  tenantId String

  /// El acceso al panel ocurre en un único host, así que el correo identifica
  /// al usuario de forma global.
  email          String     @unique
  nombre         String
  contrasenaHash String
  rol            RolUsuario @default(PROPIETARIO)
  activo         Boolean    @default(true)

  ultimoAccesoEn DateTime?
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("usuarios")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tienda y catálogo
// ─────────────────────────────────────────────────────────────────────────────

/// Escaparate público de un tenant. Relación 1 a 1 con Tenant.
model Tienda {
  id       String @id @default(cuid())
  tenantId String @unique

  nombre      String
  descripcion String?
  logoUrl     String?
  faviconUrl  String?

  /// Plantilla base elegida en el panel ("clasica", "minimal", …).
  plantilla            String @default("clasica")
  /// Sobrescrituras de tema: colores, tipografías, radios. Se inyecta como
  /// variables CSS en la tienda pública.
  tema                 Json   @default("{}")
  /// Diseño del constructor drag-and-drop: array ordenado de bloques
  /// ({ id, tipo, props }). Se guarda como JSON, nunca como HTML generado.
  configuracionBloques Json   @default("[]")
  /// Cabecera, contacto y redes: menú, buscador, WhatsApp, dirección, horario.
  /// JSON libre validado en la API (ver esquemaAjustes en panel.controlador).
  ajustes              Json   @default("{}")

  moneda    String  @default("COP")
  publicada Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productos Producto[]
  pedidos   Pedido[]
  cupones   Cupon[]
  visitas   VisitaDiaria[]
  pasarelas PasarelaTienda[]

  @@map("tiendas")
}

model Producto {
  id       String @id @default(cuid())
  tiendaId String

  nombre      String
  /// Único dentro de la tienda: /productos/<slug>
  slug        String
  descripcion String?

  /// Pesos colombianos. Decimal (no float) para no perder precisión en dinero.
  precio            Decimal  @db.Decimal(12, 2)
  precioComparacion Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  /// URLs públicas en Cloudflare R2, ya optimizadas por la cola de imágenes.
  fotos             String[]
  /// Agrupa el catálogo: alimenta las secciones de categorías y sus páginas.
  categoria         String?
  /// Cómo se vende: "500 gr", "Paquete x 10", "Talla única".
  presentacion      String?

  activo    Boolean @default(true)
  /// Sale primero en el catálogo y en las secciones "sólo destacados".
  destacado Boolean @default(false)

  /// Opciones del producto: [{ nombre: "Talla", valores: ["S", "M"] }].
  opciones  Json @default("[]")
  /// Una por combinación de valores: [{ id, nombre, valores, precio?, stock }].
  /// Si hay variantes, `stock` es la suma de las suyas.
  variantes Json @default("[]")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda      Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  itemsPedido ItemPedido[]

  @@unique([tiendaId, slug])
  @@index([tiendaId, activo])
  @@index([tiendaId, categoria])
  @@map("productos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pedidos y pagos
// ─────────────────────────────────────────────────────────────────────────────

model Pedido {
  id       String @id @default(cuid())
  tiendaId String
  /// Consecutivo visible al cliente, reiniciado por tienda.
  numero   Int

  clienteNombre   String
  clienteEmail    String
  clienteTelefono String?
  /// { ciudad, direccion, detalle } tal como los escribió el cliente.
  direccionEnvio  Json?
  /// Lo que el cliente quiso aclarar al pedir.
  notas           String?

  /// Por dónde llegó: "web" (confirmó en la tienda) o "whatsapp" (lo mandó por chat).
  canal       String  @default("web")
  /// "contra-entrega", "transferencia" o "acordar". Wompi/PSE llegan con Pago.
  metodoPago  String  @default("acordar")
  /// Código del cupón aplicado, guardado tal cual para el histórico.
  cupon       String?
  /// Nota interna de la tienda; el cliente no la ve.
  notaInterna String?

  estado    EstadoPedido @default(PENDIENTE)
  subtotal  Decimal      @db.Decimal(12, 2)
  descuento Decimal      @default(0) @db.Decimal(12, 2)
  envio     Decimal      @default(0) @db.Decimal(12, 2)
  total     Decimal      @db.Decimal(12, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  items  ItemPedido[]
  pago   Pago?

  @@unique([tiendaId, numero])
  @@index([tiendaId, estado])
  @@index([tiendaId, creadoEn])
  @@map("pedidos")
}

/// Línea de un pedido. Guarda una instantánea de nombre y precio para que
/// editar o borrar el producto no altere el histórico de ventas.
model ItemPedido {
  id         String  @id @default(cuid())
  pedidoId   String
  productoId String?

  nombreProducto String
  /// Variante elegida ("Talla M · Rojo"), si el producto las tiene.
  variante       String?
  foto           String?
  precioUnitario Decimal @db.Decimal(12, 2)
  cantidad       Int
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([productoId])
  @@map("items_pedido")
}

/// Sólo el modelo de datos. La integración con Wompi/PSE llega en una fase
/// posterior.
model Pago {
  id       String @id @default(cuid())
  pedidoId String @unique

  proveedor      ProveedorPago
  estado         EstadoPago    @default(PENDIENTE)
  /// Referencia con la que la pasarela identifica la transacción.
  referencia     String        @unique
  monto          Decimal       @db.Decimal(12, 2)
  /// Carga cruda del webhook, para auditoría y conciliación.
  datosProveedor Json?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@map("pagos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Oferta comercial
// ─────────────────────────────────────────────────────────────────────────────

/// Lo que se muestra de cada plan en la página de precios. Lo edita el admin
/// de la plataforma; los límites técnicos del plan viven en el código
/// (src/utilidades/planes.ts). Si falta una fila, se usa la oferta por defecto.
model OfertaPlan {
  plan PlanTenant @id

  /// Pesos colombianos al mes. 0 = gratis.
  precio      Int
  /// Pesos colombianos por un año pagado de una vez. 0 = sin pago anual.
  precioAnual Int      @default(0)
  resumen     String
  incluye     String[]
  destacado   Boolean  @default(false)

  actualizadoEn DateTime @updatedAt

  @@map("ofertas_planes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Descuentos
// ─────────────────────────────────────────────────────────────────────────────

enum TipoCupon {
  PORCENTAJE
  FIJO
  ENVIO_GRATIS
}

model Cupon {
  id       String @id @default(cuid())
  tiendaId String

  /// En mayúsculas, como lo escribe el cliente: "BIENVENIDA10".
  codigo String
  tipo   TipoCupon
  /// Porcentaje (1-100) o pesos, según el tipo. Ignorado en envío gratis.
  valor  Decimal   @default(0) @db.Decimal(12, 2)
  /// Subtotal mínimo para que aplique.
  minimo Decimal?  @db.Decimal(12, 2)

  usosMaximos Int?
  usos        Int       @default(0)
  venceEn     DateTime?
  activo      Boolean   @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, codigo])
  @@map("cupones")
}

// ─────────────────────────────────────────────────────────────────────────────
// Estadísticas
// ─────────────────────────────────────────────────────────────────────────────

/// Un renglón por tienda y día: cuántas visitas tuvo y a qué productos.
/// Agregado, sin datos de quién visitó: no hace falta pedir consentimiento.
model VisitaDiaria {
  id       String   @id @default(cuid())
  tiendaId String
  fecha    DateTime @db.Date

  visitas        Int  @default(0)
  /// Primera página de cada visitante en el día (aprox. visitantes únicos).
  visitantes     Int  @default(0)
  clicsWhatsapp  Int  @default(0)
  /// { [productoId]: vistas }
  vistasProducto Json @default("{}")

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, fecha])
  @@map("visitas_diarias")
}

// ─────────────────────────────────────────────────────────────────────────────
// Suscripciones (cobradas con Bold)
// ─────────────────────────────────────────────────────────────────────────────

enum PeriodoSuscripcion {
  MENSUAL
  ANUAL
}

/// Cada intento de pagar un plan. Se crea al abrir el checkout de Bold y lo
/// confirma el webhook (o la consulta a Bold al volver del pago).
model PagoSuscripcion {
  id       String @id @default(cuid())
  tenantId String

  plan          PlanTenant
  periodo       PeriodoSuscripcion
  /// Pesos colombianos, tal como se le cobró.
  monto         Int
  /// Order id que viaja a Bold y vuelve en el webhook.
  referencia    String             @unique
  estado        EstadoPago         @default(PENDIENTE)
  /// Id de la transacción en Bold, cuando llega.
  idBold        String?
  /// Carga cruda del webhook, para conciliación.
  datosBold     Json?
  /// Hasta dónde dejó pago el plan este cobro (sólo si se aprobó).
  cubreHasta    DateTime?
  /// Cupón de suscripción aplicado y el precio antes del descuento.
  cuponCodigo   String?
  montoOriginal Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, creadoEn])
  @@map("pagos_suscripcion")
}

// ─────────────────────────────────────────────────────────────────────────────
// Administración de la plataforma
// ─────────────────────────────────────────────────────────────────────────────

enum RolAdmin {
  DUENO
  SOPORTE
  LECTURA
}

/// Personas de Llano Studio con acceso al admin. El correo del .env sigue
/// entrando como dueño; si se guarda aquí con ese correo, manda lo de aquí.
model AdminPlataforma {
  id             String    @id @default(cuid())
  email          String    @unique
  nombre         String
  contrasenaHash String
  rol            RolAdmin  @default(SOPORTE)
  activo         Boolean   @default(true)
  ultimoAccesoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("admins_plataforma")
}

/// Quién hizo qué en el admin.
model ActividadAdmin {
  id       String  @id @default(cuid())
  admin    String
  accion   String
  detalle  String?
  tenantId String?

  creadoEn DateTime @default(now())

  @@index([creadoEn])
  @@index([tenantId])
  @@map("actividad_admin")
}

model NotaTienda {
  id       String @id @default(cuid())
  tenantId String
  autor    String
  texto    String

  creadoEn DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, creadoEn])
  @@map("notas_tienda")
}

/// Cada cambio de plan y por qué: pago, admin, vencimiento, prueba, referido…
model HistorialPlan {
  id           String     @id @default(cuid())
  tenantId     String
  planAnterior PlanTenant
  planNuevo    PlanTenant
  motivo       String
  detalle      String?

  creadoEn DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, creadoEn])
  @@index([creadoEn])
  @@map("historial_planes")
}

/// Descuento sobre el precio de un plan al pagarlo con Bold.
model CuponSuscripcion {
  id          String       @id @default(cuid())
  /// En mayúsculas: "LANZAMIENTO50".
  codigo      String       @unique
  porcentaje  Int
  /// Vacío = sirve para todos los planes.
  planes      PlanTenant[] @default([])
  usosMaximos Int?
  usos        Int          @default(0)
  venceEn     DateTime?
  activo      Boolean      @default(true)

  creadoEn DateTime @default(now())

  @@map("cupones_suscripcion")
}

enum TipoAnuncio {
  CAMPANA
  BARRA
}

/// Mensaje de la plataforma a las tiendas: en la campana o en una barra arriba del panel.
model Anuncio {
  id     String       @id @default(cuid())
  titulo String
  cuerpo String
  tipo   TipoAnuncio  @default(CAMPANA)
  /// Vacío = para todos los planes.
  planes PlanTenant[] @default([])
  activo Boolean      @default(true)
  desde  DateTime     @default(now())
  hasta  DateTime?

  creadoEn DateTime @default(now())

  @@index([activo, desde])
  @@map("anuncios")
}

/// Historial de cambios de la plataforma que ven las tiendas en el panel.
model Novedad {
  id          String   @id @default(cuid())
  titulo      String
  cuerpo      String
  etiqueta    String?
  publicadaEn DateTime @default(now())

  @@index([publicadaEn])
  @@map("novedades")
}

/// Nombres que nadie puede usar como subdominio (marcas, suplantaciones…).
model SubdominioBloqueado {
  subdominio String  @id
  motivo     String?

  creadoEn DateTime @default(now())

  @@map("subdominios_bloqueados")
}

/// Ajustes sueltos de la plataforma, guardados como JSON por clave:
/// prueba gratis, referidos, preguntas frecuentes, testimonios, mantenimiento…
model ConfiguracionPlataforma {
  clave String @id
  valor Json

  actualizadoEn DateTime @updatedAt

  @@map("configuracion_plataforma")
}

/// Artículos del blog editados desde el admin. Los del código siguen
/// apareciendo salvo que uno de aquí tenga el mismo slug.
model Articulo {
  id        String   @id @default(cuid())
  slug      String   @unique
  titulo    String
  categoria String
  resumen   String
  portada   String
  minutos   Int      @default(4)
  /// [{ titulo?, parrafos: string[], lista?: string[] }]
  secciones Json
  publicado Boolean  @default(true)
  fecha     DateTime @default(now())

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("articulos")
}

/// Correos automáticos ya enviados, para no repetirlos.
model CorreoEnviado {
  id       String @id @default(cuid())
  tenantId String
  tipo     String
  /// Distingue envíos del mismo tipo: la fecha de vencimiento, por ejemplo.
  clave    String

  creadoEn DateTime @default(now())

  @@unique([tenantId, tipo, clave])
  @@map("correos_enviados")
}

// ─────────────────────────────────────────────────────────────────────────────
// Soporte en vivo
// ─────────────────────────────────────────────────────────────────────────────

enum EstadoTicket {
  ABIERTO
  EN_CURSO
  RESUELTO
}

enum OrigenTicket {
  LANDING
  PANEL
}

enum AutorMensaje {
  CLIENTE
  ASESOR
  SISTEMA
}

/// Conversación de soporte. Desde la web la abre cualquiera (se reconecta con
/// tokenVisitante); desde el panel queda ligada a la tienda.
model TicketSoporte {
  id             String       @id @default(cuid())
  numero         Int          @unique @default(autoincrement())
  origen         OrigenTicket
  tenantId       String?
  nombre         String
  email          String
  asunto         String?
  estado         EstadoTicket @default(ABIERTO)
  /// Correo del asesor que lo tomó.
  asignadoA      String?
  tokenVisitante String       @unique
  calificacion   Int?

  noLeidosAsesor  Int       @default(0)
  noLeidosCliente Int       @default(0)
  ultimoMensajeEn DateTime  @default(now())
  cerradoEn       DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  mensajes MensajeSoporte[]

  @@index([estado, ultimoMensajeEn])
  @@index([tenantId])
  @@map("tickets_soporte")
}

model MensajeSoporte {
  id          String       @id @default(cuid())
  ticketId    String
  autor       AutorMensaje
  nombreAutor String
  texto       String

  creadoEn DateTime @default(now())

  ticket TicketSoporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, creadoEn])
  @@map("mensajes_soporte")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pasarelas de pago de cada tienda
// ─────────────────────────────────────────────────────────────────────────────

/// Cuenta de Wompi, ePayco o Bold de una tienda: el dinero de sus ventas va
/// directo a esa cuenta. Los secretos se guardan cifrados (utilidades/cifrado).
model PasarelaTienda {
  id         String        @id @default(cuid())
  tiendaId   String
  proveedor  ProveedorPago
  activa     Boolean       @default(false)
  /// Llaves de prueba de la pasarela: el cobro no es real.
  modoPrueba Boolean       @default(true)

  /// Lo que se puede mostrar: llave pública (Wompi, ePayco) o de identidad (Bold).
  llavePublica String
  /// JSON cifrado con los secretos de cada pasarela.
  secretos     String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, proveedor])
  @@map("pasarelas_tienda")
}
