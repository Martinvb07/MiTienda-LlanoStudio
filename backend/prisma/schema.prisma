// Esquema de datos de Mi Tienda — SaaS multi-tenant de e-commerce (Llano Studio)
//
// Estrategia de aislamiento: base de datos y esquema únicos, con separación por
// fila. Todo registro cuelga de un Tenant, ya sea de forma directa (tenantId) o
// a través de su Tienda (tiendaId). Todas las consultas de la API deben filtrar
// siempre por el tenant resuelto en el middleware `resolverTenant`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generado/prisma"
  moduleFormat = "esm"
}

// Prisma 7 ya no admite `url` aquí: la cadena de conexión para migraciones vive
// en prisma.config.ts, y el cliente en runtime la recibe vía driver adapter
// (ver src/config/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enumeraciones
// ─────────────────────────────────────────────────────────────────────────────

enum PlanTenant {
  GRATIS
  EMPRENDE
  NEGOCIO
  PRO
}

enum RolUsuario {
  PROPIETARIO
  ADMINISTRADOR
  EDITOR
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
  REEMBOLSADO
}

enum ProveedorPago {
  WOMPI
  PSE
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  ANULADO
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant y acceso
// ─────────────────────────────────────────────────────────────────────────────

/// Cuenta cliente de la plataforma. Es la raíz del aislamiento multi-tenant.
model Tenant {
  id         String     @id @default(cuid())
  nombre     String
  /// Etiqueta usada como <subdominio>.llanostudio.co. Única en toda la plataforma.
  subdominio String     @unique
  plan       PlanTenant @default(GRATIS)
  activo     Boolean    @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda   Tienda?
  usuarios Usuario[]
  dominios DominioPropio[]

  @@map("tenants")
}

/// Dominios propios apuntados a la plataforma ("tabla de dominios propios" que
/// consulta `resolverTenant` cuando el Host no cae bajo DOMINIO_BASE).
model DominioPropio {
  id       String @id @default(cuid())
  tenantId String
  /// Host completo en minúsculas y sin puerto, p. ej. "www.miropa.com".
  dominio  String @unique

  /// Pasa a true cuando se comprueba el registro DNS. `resolverTenant` sólo
  /// sirve tráfico de dominios verificados.
  verificado  Boolean @default(false)
  esPrincipal Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dominios_propios")
}

/// Usuario del panel de administración (dueño o colaborador de una tienda).
model Usuario {
  id       String @id @default(cuid())
  tenantId String

  /// El acceso al panel ocurre en un único host, así que el correo identifica
  /// al usuario de forma global.
  email          String     @unique
  nombre         String
  contrasenaHash String
  rol            RolUsuario @default(PROPIETARIO)
  activo         Boolean    @default(true)

  ultimoAccesoEn DateTime?
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("usuarios")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tienda y catálogo
// ─────────────────────────────────────────────────────────────────────────────

/// Escaparate público de un tenant. Relación 1 a 1 con Tenant.
model Tienda {
  id       String @id @default(cuid())
  tenantId String @unique

  nombre      String
  descripcion String?
  logoUrl     String?
  faviconUrl  String?

  /// Plantilla base elegida en el panel ("clasica", "minimal", …).
  plantilla String @default("clasica")
  /// Sobrescrituras de tema: colores, tipografías, radios. Se inyecta como
  /// variables CSS en la tienda pública.
  tema      Json   @default("{}")
  /// Diseño del constructor drag-and-drop: array ordenado de bloques
  /// ({ id, tipo, props }). Se guarda como JSON, nunca como HTML generado.
  configuracionBloques Json @default("[]")

  moneda    String  @default("COP")
  publicada Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productos Producto[]
  pedidos   Pedido[]

  @@map("tiendas")
}

model Producto {
  id       String @id @default(cuid())
  tiendaId String

  nombre      String
  /// Único dentro de la tienda: /productos/<slug>
  slug        String
  descripcion String?

  /// Pesos colombianos. Decimal (no float) para no perder precisión en dinero.
  precio            Decimal  @db.Decimal(12, 2)
  precioComparacion Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  /// URLs públicas en Cloudflare R2, ya optimizadas por la cola de imágenes.
  fotos             String[]

  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda      Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  itemsPedido ItemPedido[]

  @@unique([tiendaId, slug])
  @@index([tiendaId, activo])
  @@map("productos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pedidos y pagos
// ─────────────────────────────────────────────────────────────────────────────

model Pedido {
  id       String @id @default(cuid())
  tiendaId String
  /// Consecutivo visible al cliente, reiniciado por tienda.
  numero   Int

  clienteNombre   String
  clienteEmail    String
  clienteTelefono String?
  direccionEnvio  Json?

  estado   EstadoPedido @default(PENDIENTE)
  subtotal Decimal      @db.Decimal(12, 2)
  envio    Decimal      @default(0) @db.Decimal(12, 2)
  total    Decimal      @db.Decimal(12, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tienda Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  items  ItemPedido[]
  pago   Pago?

  @@unique([tiendaId, numero])
  @@index([tiendaId, estado])
  @@map("pedidos")
}

/// Línea de un pedido. Guarda una instantánea de nombre y precio para que
/// editar o borrar el producto no altere el histórico de ventas.
model ItemPedido {
  id         String  @id @default(cuid())
  pedidoId   String
  productoId String?

  nombreProducto String
  precioUnitario Decimal @db.Decimal(12, 2)
  cantidad       Int
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([productoId])
  @@map("items_pedido")
}

/// Sólo el modelo de datos. La integración con Wompi/PSE llega en una fase
/// posterior.
model Pago {
  id       String @id @default(cuid())
  pedidoId String @unique

  proveedor  ProveedorPago
  estado     EstadoPago    @default(PENDIENTE)
  /// Referencia con la que la pasarela identifica la transacción.
  referencia String        @unique
  monto      Decimal       @db.Decimal(12, 2)
  /// Carga cruda del webhook, para auditoría y conciliación.
  datosProveedor Json?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([estado])
  @@map("pagos")
}
