# Copia este archivo a .env.local y completa los valores.

# ── Backend ──────────────────────────────────────────────────────────────────
# URL de la API de Express. En el VPS suele ser http://127.0.0.1:4000
URL_API="http://localhost:4000"

# Secreto compartido con el backend (TOKEN_INTERNO en backend/.env). Permite que
# el renderizado en servidor resuelva el tenant indicando el Host original.
MITIENDA_TOKEN_INTERNO="cambia-esto-tambien-en-produccion"

# ── Dominios / multi-tenant ──────────────────────────────────────────────────
# Deben coincidir con los del backend.
NEXT_PUBLIC_DOMINIO_BASE="llanostudio.co"
NEXT_PUBLIC_SUBDOMINIO_PANEL="misitio"

# ── Autenticación del panel (NextAuth/Auth.js — fase siguiente) ──────────────
# AUTH_SECRET="genera-uno-con: npx auth secret"
